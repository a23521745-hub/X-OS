#!/bin/sh
# xos-session — X-OS / PlasmaX oturum başlangıcı.
# SDDM (veya herhangi bir display manager) bu dosyayı başlatır.
set -eu

export XDG_CURRENT_DESKTOP="X-OS:PlasmaX"
export XDG_SESSION_DESKTOP="plasmax"
export XDG_SESSION_TYPE="${XDG_SESSION_TYPE:-wayland}"
export QT_QPA_PLATFORM="${QT_QPA_PLATFORM:-wayland;xcb}"
export QT_WAYLAND_DISABLE_WINDOWDECORATION=1
export XOS_VERSION="${XOS_VERSION:-0.1.0}"

RUNDIR="${XDG_RUNTIME_DIR:-/tmp}"
LOG="/tmp/xos-session.log"
log() {
    echo "[$(date '+%F %T')] $*" >> "$LOG" 2>/dev/null || true
    command -v logger >/dev/null 2>&1 && logger -t xos-session -- "$*" 2>/dev/null || true
}
set +e

log "oturum başlıyor: xos-session (XOS_VERSION=$XOS_VERSION)"

# 1) Compositor: KWin'i salt Wayland compositor olarak başlat.
#    (plasmashell YOK; panel/dock/launcher görevlerini plasmex üstlenir.)
log "kwin_wayland --xwayland başlatılıyor"
kwin_wayland --xwayland >> "$LOG" 2>&1 &
KWIN_PID=$!
log "kwin pid=$KWIN_PID"

# 2) Wayland soketini bekle (kwin wayland-0'u $XDG_RUNTIME_DIR'de açar;
#    libwayland WAYLAND_DISPLAY yoksa varsayılan "wayland-0"'a düşer).
i=0
while [ ! -S "$RUNDIR/wayland-0" ] && [ "$i" -lt 100 ]; do
    kill -0 "$KWIN_PID" 2>/dev/null || break
    sleep 0.1
    i=$((i + 1))
done

# 3) Shell
if [ -S "$RUNDIR/wayland-0" ]; then
    log "wayland-0 soketi hazır"
else
    log "UYARI: wayland-010 sn içinde açılmadı (kwin ölmüş olabilir)"
fi
if command -v plasmex >/dev/null 2>&1; then
    log "plasmex başlatılıyor: $(command -v plasmex)"
    plasmex >> "$LOG" 2>&1 &
else
    log "HATA: plasmex komutu YOK — shell yüklenmeyecek (binary imajda eksik!)"
fi

# 4) Ses (varsa)
command -v pipewire >/dev/null 2>&1 && pipewire &
command -v wireplumber >/dev/null 2>&1 && wireplumber &

# Compositor ayakta kaldığı sürece oturum yaşar.
log "kwin kapanması bekleniyor (pid=$KWIN_PID)"
wait "$KWIN_PID"
RET=$?
log "kwin çıktı rc=$RET"

set -e
exit "$RET"
