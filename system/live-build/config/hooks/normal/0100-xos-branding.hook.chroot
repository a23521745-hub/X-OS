#!/bin/sh
# normal hook: marka varlıkları + oturum varsayılanları (chroot içi).
set -eu
CHROOT="$(pwd)/chroot"

# SDDM: PlasmaX oturumunu varsayılan yap.
if [ -d "$CHROOT/etc/sddm.conf.d" ]; then
    cat > "$CHROOT/etc/sddm.conf.d/10-xos.conf" <<'EOF'
[Autologin]
Session=plasmax.desktop

[Users]
DefaultUser=xos

[Wayland]
CompositorCommand=
EOF
fi

# Varsayılan kullanıcı ismi (live).
if [ -f "$CHROOT/etc/hostname" ]; then
    echo "x-os" > "$CHROOT/etc/hostname"
fi

# Duvar kâğıdı dizini (shell ilk açılışta okur).
mkdir -p "$CHROOT/usr/share/backgrounds/xos"
if [ -f "$CHROOT/usr/share/backgrounds/xos/default.svg" ]; then
    :
fi
